# Used by Cloudflare Pages and Netlify (GitHub Pages ignores this file;
# index.html carries the same Content-Security-Policy as a meta tag).
/*
  Content-Security-Policy: default-src 'self'; script-src 'self'; style-src 'self'; img-src 'self' data:; frame-src https://script.google.com https://*.googleusercontent.com; connect-src 'self'; manifest-src 'self'; worker-src 'self'; base-uri 'none'; form-action 'none'; object-src 'none'; frame-ancestors 'none'
  X-Content-Type-Options: nosniff
  Referrer-Policy: no-referrer
  Permissions-Policy: camera=(), microphone=(), geolocation=(), payment=(), usb=()
  Strict-Transport-Security: max-age=31536000

/sw.js
  Cache-Control: no-cache

/config.js
  Cache-Control: no-cache

/manifest.webmanifest
  Content-Type: application/manifest+json
